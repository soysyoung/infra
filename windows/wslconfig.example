# %UserProfile%\.wslconfig 로 복사해서 쓴다. Ubuntu 를 처음 띄우기 전에 두는 것이 좋다.
# 값은 wsl --shutdown 후 WSL 을 다시 시작할 때 적용된다.
#
# 참고 (공식 문서): https://learn.microsoft.com/en-us/windows/wsl/wsl-config#wslconfig
[wsl2]
# 32GB 중 Windows 에 8GB 를 남긴다. Kubeflow 는 16GB 이상을 권장한다.
memory=24GB
swap=8GB
# Windows 와 네트워크 인터페이스 공유. Windows 11 22H2 이상, WSL 2.0 이상 필요.
networkingMode=mirrored

# vmIdleTimeout 은 밀리초 단위(기본 60000)이고 -1 이 "끄기"라는 문서는 없다 (-1 은 [general] instanceIdleTimeout 에만 문서화됨).
# 상시 구동은 이 옵션 대신 Windows 로그온/시작 작업으로 배포판을 띄우는 방식(autostart.ps1)으로 하고 동작을 확인한다.
