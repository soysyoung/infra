# 버전 단일 출처. 스크립트가 source 하고, 이후 Terraform 도 이 값을 따른다.
# 근거와 확인일: docs/versions.md, docs/decisions/

# 확인일: 2026-10-23
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
KUBECTL_VERSION=v1.36.4
DEVICE_PLUGIN_VERSION=v0.20.1
KUBEFLOW_VERSION=26.03.1
NVIDIA_TOOLKIT_VERSION=1.20.1
KUSTOMIZE_VERSION=v5.8.1

# Docker 29.x: 비워 두면 03-docker.sh 가 설치 가능한 29.x 목록을 보여주고 멈춘다.
# 선택 기준: 직전 마이너(29.8)의 마지막 패치 29.8.2(2026-09-30). 다음 마이너 29.9.0 이 나온 지 2주 이상 지났다.
DOCKER_VERSION=5:29.8.2-1~ubuntu.24.04~noble

# GPU 검증 이미지. Blackwell(RTX 50xx)은 CUDA 12.8 이상이 필요하다고 알려져 있다.
CUDA_TEST_IMAGE=nvidia/cuda:12.8.1-base-ubuntu24.04

# 확인일: 2026-10-28. OpenSearch 는 Docker 와 같은 기준(직전 마이너)으로 3.8.0(2026-08-05, 패치 없음). 3.9.0 은 2026-09-29 라 한 달밖에 안 됐다.
# 차트 버전과 앱 버전이 같다 (차트 opensearch-3.8.0 = OpenSearch 3.8.0). Helm 은 4.3.0(2026-09-09)이 2주 넘게 지나서 직전 마이너 4.2 의 마지막 패치.
OPENSEARCH_CHART_VERSION=3.8.0
# 확인일: 2026-10-28. Dashboards 차트는 OpenSearch 와 버전을 맞춘다 (태그 opensearch-dashboards-3.8.0 의 Chart.yaml: version, appVersion 모두 3.8.0).
OPENSEARCH_DASHBOARDS_CHART_VERSION=3.8.0
HELM_VERSION=v4.2.4
# 확인일: 2026-10-30. CloudNativePG 연산자 Helm 차트 0.29.1 = 연산자 1.30.1 (charts 저장소 main 의 Chart.yaml: version 0.29.1, appVersion 1.30.1. 차트는 최신 패치만 지원한다고 README 에 있음).
# PostgreSQL 이미지는 연산자 1.30.1 의 기본값(pkg/versions/versions.go DefaultImageName)을 그대로 고정한다. 차트와 릴리스 날짜는 확인하지 못했다.
CNPG_CHART_VERSION=0.29.1
POSTGRES_IMAGE=ghcr.io/cloudnative-pg/postgresql:18.6-system-trixie
